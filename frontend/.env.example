# Copy to frontend/.env.production.local (git-ignored) before ./bin/deploy-frontend.sh.
# Optional: lets the admin's browser email sign-in details through EmailJS when the server can't send email.
# Leave empty to keep the show-once dialog only.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
